# Local dev defaults. On Vercel, set these as Project Environment
# Variables in the dashboard.

PORT=4003

# Session signing secret — must be a long random string in production
# (32+ random bytes hex-encoded). Used to HMAC the session cookie.
SESSION_SECRET=

# External integrations the member sees on the dashboard.
# Discord invite — full URL, e.g. https://discord.gg/abc123
DISCORD_URL=
# Stripe customer billing portal — full URL, e.g. https://billing.stripe.com/p/login/aBc123
STRIPE_BILLING_URL=

# Database (libSQL / Turso). Defaults to a local file for dev.
# In production, point at the SAME Turso DB the admin portal uses,
# so a member's email auto-links to their leads/payments/bookings.
TURSO_DATABASE_URL=file:db/algo-member.db
TURSO_AUTH_TOKEN=

# CORS — usually only the member portal itself calls its API,
# so '*' or the portal's origin is fine.
ALLOWED_ORIGINS=*
